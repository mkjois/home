[user]
    name = Manny Jois
    email = 3893724+mkjois@users.noreply.github.com
    #signingkey = <KEY_ID>
[core]
    excludesfile = ~/.gitignore
    commentChar = ";"
[pull]
    ff = only
[push]
    default = simple
[commit]
    template = ~/.gitmessage
    #gpgsign = true
[tag]
    #gpgsign = true
[grep]
    patternType = extended
    lineNumber = true
[alias]
    a = add .
    au = add -u .
    bd = branch -D
    r = reset HEAD --
    c = checkout
    ca = co --amend --no-edit .
    cb = checkout -b
    #co = !gpg --sign -u ${EMAIL_FOR_GITHUB} -o /dev/null ~/.gitmessage && git commit
    co = commit
    d = diff
    p = !git pull origin $(git rev-parse --abbrev-ref HEAD)
    pu = !git push -u origin $(git rev-parse --abbrev-ref HEAD)
    pf = push -f
    s = stash
    sl = stash list
    sp = stash pop
    trash = !git remote prune origin && git prune -v && git gc --aggressive
    trunk = clone --depth 5 --single-branch
[filter "lfs"]
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
